{
  "name": "@zylith/sdk",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist/common.*",
    "dist/index.*",
    "dist/liquidity.*",
    "dist/relay.*",
    "dist/trader.*",
    "dist/wallet.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js"
    },
    "./trader": {
      "types": "./dist/trader.d.ts",
      "import": "./dist/trader.js"
    },
    "./liquidity": {
      "types": "./dist/liquidity.d.ts",
      "import": "./dist/liquidity.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "import": "./dist/relay.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
