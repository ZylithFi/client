{
  "name": "zylith-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:sdk && vite",
    "build": "npm run build:sdk && npm run build:wallet && tsc -b && vite build",
    "build:app": "npm run build:sdk && tsc -b && vite build",
    "build:sdk": "tsc -p ./sdk/tsconfig.json",
    "build:wallet": "./build-wallet-wasm.sh",
