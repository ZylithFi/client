    "test:watch": "npm run build:sdk && vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@starkware-libs/starknet-privacy-sdk": "0.14.3-rc.0",
    "@zylith/sdk": "file:./sdk",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "starknet": "^10.4.0",
    "starknet-devnet": "file:./stubs/starknet-devnet"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
