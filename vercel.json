{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "node -e 'const fs=require(\"fs\"); const v=process.env.ZYLITH_DEPLOYMENT_JSON; if(!v) throw new Error(\"ZYLITH_DEPLOYMENT_JSON missing\"); JSON.parse(v); fs.writeFileSync(\"public/deployment.json\", v);' && npm run build:app",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/deployment.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/wallet/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.zylith.fi; worker-src 'self' blob:; manifest-src 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/starknet-privacy-discovery/:path*",
      "destination": "https://api.zylith.fi/starknet-privacy-discovery/:path*"
    },
    {
      "source": "/starknet-privacy-prover",
      "destination": "https://api.zylith.fi/starknet-privacy-prover"
    },
    {
      "source": "/starknet-privacy-prover/:path*",
      "destination": "https://api.zylith.fi/starknet-privacy-prover/:path*"
    },
    {
      "source": "/starknet-privacy-prover-sepolia",
      "destination": "https://api.zylith.fi/starknet-privacy-prover-sepolia"
    },
    {
      "source": "/starknet-privacy-prover-sepolia/:path*",
      "destination": "https://api.zylith.fi/starknet-privacy-prover-sepolia/:path*"
    },
    {
      "source": "/paymaster/:path*",
      "destination": "https://api.zylith.fi/paymaster/:path*"
    },
    {
      "source": "/market-data/:path*",
      "destination": "https://api.zylith.fi/market-data/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
