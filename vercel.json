{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:app",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/starknet-privacy-discovery/:path*",
      "destination": "http://35.192.48.142:8080/:path*"
    },
    {
      "source": "/starknet-privacy-prover",
      "destination": "http://34.29.249.119:3000"
    },
    {
      "source": "/starknet-privacy-prover/:path*",
      "destination": "http://34.29.249.119:3000/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
